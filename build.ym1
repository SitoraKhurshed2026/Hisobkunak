name: Build APK
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3
      - name: Build APK
        uses: ArtemSBulgakov/buildozer-action@v1
        id: buildozer
        with:
          workdir:.
      - name: Upload APK
        uses: actions/upload-artifact@v3
        with:
          name: apk
          path: ${{ steps.buildozer.outputs.filename }}
